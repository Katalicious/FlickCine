<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/swing/5.5.4/swing.min.js"></script>
    <style>
        /* Estilo rápido para os cartões não ficarem invisíveis se o JS falhar */
        ul { list-style: none; padding: 0; position: relative; height: 400px; width: 300px; margin: 50px auto; }
        li { position: absolute; width: 100%; height: 100%; background: #fff; border: 1px solid #ccc; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <ul>
            <li style="z-index: 3; background-color: #eee;">Filme 1</li>
            <li style="z-index: 2; background-color: #ddd;">Filme 2</li>
            <li style="z-index: 1; background-color: #ccc;">Filme 3</li>
        </ul>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/swipe.js"></script>
</body>
</html>