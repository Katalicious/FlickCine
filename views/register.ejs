<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <%- include('partials/head', { extraCss: 'register.css' }) %>
</head>
<body>
    <%- include('partials/header') %>

    <h1 class="criar-conta" id="criar-conta">Criar Conta</h1>

    <div class="box" id="create-account-box">
      <form action="/register" method="POST">
        <label for="name">Nome:</label>
        <input type="text" id="name" name="name" placeholder="O teu nome completo" required />
        <p id="BlurName"></p>

        <label for="idade">Insere a tua data de nascimento:</label>
        <input type="date" id="idade" name="idade" required />

        <label for="email">Email:</label>
        <input type="email" id="email" name="email" placeholder="meuemail@exemplo.com" required />
        <p id="BlurEmail"></p>

        <label for="sexo">Sexo:</label>
        <select id="sexo" name="sexo" required>
          <option value="" disabled selected>Seleciona o teu sexo</option>
          <option value="masculino">Masculino</option>
          <option value="feminino">Feminino</option>
          <option value="outro">Outro</option>
        </select>

        <label for="password">Palavra-passe:</label>
        <input type="password" id="password" name="password" required />

        <label for="confirm-password">Confirmar Palavra-passe:</label>
        <input type="password" id="confirm-password" name="confirm-password" required />

        <div class="termos-condicoes-box">
          <input id="terms-checkbox" type="checkbox" required />
          <label for="terms-checkbox">
            Ao criar uma conta, estás a concordar com os nossos <a href="#">Termos e Condições</a>.
          </label>
        </div>

        <button type="submit" class="botaoregisto">Registar conta</button>
        <p class="parag-final">Já tens uma conta? <a href="/login">Login</a></p>
      </form>
    </div>

    <div id="mensagem-de-erro-palavra-passe">
      <h3>A palavra-passe deve conter o seguinte:</h3>
      <p id="letra" class="invalid">Uma letra <b>minúscula</b></p>
      <p id="maiúscula" class="invalid">Uma letra <b>maiúscula</b></p>
      <p id="numero" class="invalid">Um <b>número</b></p>
      <p id="comprimento" class="invalid">Mínimo de <b>8 caracteres</b></p>
    </div>

    <%- include('partials/footer') %>
    <script src="/js/register.js"></script>
</body>
</html>