<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <%- include('partials/head', { extraCss: 'profile.css' }) %>
</head>
<body>
    <%- include('partials/header') %>

    <div class="profile-container">
        
        <div class="sidebar" id="sidebar">
            
            <div class="profile-picture">
                <img src="<%= (user && user.id) ? ('/avatars/' + user.id) : '/img/avatar_placeholder.png' %>" alt="Profile Avatar">
            </div>
            <h2 class="username"><%= user.Nome_de_Utilizador %></h2>

            <div class="alterar-dados">
                <a href="#" id="alterar-avatar"><i class="fas fa-user-edit"></i> Alterar Avatar</a>
                <a href="#" id="alterar-password"><i class="fas fa-key"></i> Alterar Palavra-passe</a>
                </div>

            <div class="filtros-ordenar-watchlist">
                <h3>Filtros</h3>
                
                <label for="ordenar-watchlist">Ordenar por:</label>
                <select id="ordenar-watchlist">
                    <option value="data-adicao">Data de Adição</option>
                    <option value="titulo-asc">Título (A-Z)</option>
                    <option value="titulo-desc">Título (Z-A)</option>
                    <option value="recente-antigo">Mais Recente</option>
                    <option value="antigo-recente">Mais Antigo</option>
                </select>

            <label for="filtro-genero">Filtrar por Género:</label>
            <select id="filtro-genero">
                <option value="todos">Todos</option>
                <option value="Ação">Ação</option>
                <option value="Aventura">Aventura</option>
                <option value="Animação">Animação</option>
                <option value="Comédia">Comédia</option>
                <option value="Crime">Crime</option>
                <option value="Documentário">Documentário</option>
                <option value="Drama">Drama</option>
                <option value="Família">Família</option>
                <option value="Fantasia">Fantasia</option>
                <option value="História">História</option>
                <option value="Terror">Terror</option>
                <option value="Música">Música</option>
                <option value="Mistério">Mistério</option>
                <option value="Romance">Romance</option>
                <option value="Ficção científica">Ficção Científica</option>
                <option value="Thriller">Thriller</option>
                <option value="Guerra">Guerra</option>
                <option value="Faroeste">Faroeste</option>
                <option value="Action & Adventure">Ação e Aventura</option>
                <option value="Sci-Fi & Fantasy">Sci-Fi e Fantasia</option>
                <option value="Kids">Infantil</option>
                <option value="Reality">Reality TV</option>
                <option value="Soap">Novelas</option>
                <option value="News">Notícias</option>
                <option value="Talk">Talk Show</option>
                <option value="War & Politics">Guerra e Política</option>
            </select>

            <h3>Filtrar pela Data do Filme:</h3>
            <label for="start-date">Data de Início:</label>
            <input type="date" id="start-date" name="start-date">
            <label for="end-date">Data de Fim:</label>
            <input type="date" id="end-date" name="end-date">
        </div>
        </div>

        <div class="watchlist-section">
            
            <% if (typeof user !== 'undefined' && user) { %>
                <h3>A minha Watchlist</h3>
                <p>Olá, <%= user.Nome_de_Utilizador %>! Aqui está a tua watchlist personalizada.</p>
        <ul id="watchlist-movies">
        <% if (typeof watchlist !== 'undefined' && watchlist.length > 0) { %>
        <% watchlist.forEach(movie => { %>
            
                <li id="movie-<%= movie.id %>" class="movie-card-item">
                
                     <a href="/details/<%= movie.id %>" class="movie-link">
                        <img src="<%= movie.poster %>" alt="<%= movie.title %>" class="movie-poster">
                    </a>

                <div class="trash-circle" onclick="event.stopPropagation(); removerFilme('<%= movie.id %>')">
                    <img src="/img/lixo.png" alt="Remover">
                </div>

                </li>

            <% }); %>
        <% } else { %>
            <li style="width: 100%; text-align: center; color: #777; list-style: none;">
                <p>Ainda não tens filmes favoritos. Começa a explorar os teus gostos!</p>
            </li>
        <% } %>
    </ul>

            <% } else { %>
                <h3>A tua watchlist não está disponível visto que não estás conectado.</h3>
                <ul style="display: none;"></ul>
            
            <% } %>

        </div>
        </div>
            <div id="confirm-modal" class="custom-modal-overlay">
                 <div class="custom-modal-box">
                    <h3>Tens a certeza?</h3>
                    <p>Queres mesmo remover este filme da tua Watchlist?</p>
                    <div class="modal-actions">
                        <button id="btn-modal-cancel" class="btn-modal btn-cancel">Cancelar</button>
                     <button id="btn-modal-confirm" class="btn-modal btn-confirm">Sim, remover</button>
                    </div>
                </div>
            </div>

        <div id="toast-container"></div>

        <%- include('partials/profile-popups') %>
        <%- include('partials/footer') %>
        <script>
            window.globalWatchlistData = <%- JSON.stringify(typeof watchlist !== 'undefined' ? watchlist : []) %>;
        </script>
        <script src="/js/profile.js"></script>
</body>
</html>