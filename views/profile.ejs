<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <%- include('partials/head', { extraCss: 'profile.css' }) %>
</head>
<body>
    <%- include('partials/header') %>

    <div class="profile-container">
        <div class="sidebar" id="sidebar">
        <div class="profile-picture">
            <img src="<%= (user && user.id) ? ('/avatars/' + user.id) : '/img/avatar_placeholder.png' %>" alt="Profile Avatar">
        </div>

        <h2 class="username"><%= user.Nome_de_Utilizador %></h2>

        <div class="alterar-dados">
            <a href="#" id="alterar-avatar">Alterar Avatar</a>
            <a href="#" id="alterar-password">Alterar Palavra-passe</a>
        </div>

        <div class="controlo-watchlist">
            <a href="#" id="remover-da-watchlist">Remover da Watchlist</a>
            <a href="/details/${movie.id}" id="ver-mais-detalhes-filme">Ver Mais Detalhes</a>
        </div>

        <div class="filtros-ordenar-watchlist">
            <label for="ordenar-watchlist">Ordenar por:</label>
            <select id="ordenar-watchlist">
                <option value="data-adicao">Data de Adição</option>
                <option value="titulo-asc">Título (A-Z)</option>
                <option value="titulo-desc">Título (Z-A)</option>
                <option value="recente-antigo">Recente para Antigo</option>
                <option value="antigo-recente">Antigo para Recente</option>
            </select>

            <label for="filtro-genero">Filtrar por Gênero:</label>
            <select id="filtro-genero">
                <option value="todos">Todos</option>
                <option value="acao">Ação</option>
                <option value="comedia">Comédia</option>
                <option value="drama">Drama</option>
                <option value="terror">Terror</option>
                <option value="ficcao-cientifica">Ficção Científica</option>
            </select>

            <h3>Filtrar pela Data do Filme:</h3>
            <label for="data-inicio">Data de Início:</label>
            <input type="date" id="data-inicio" name="data-inicio">
            <label for="data-fim">Data de Fim:</label>
            <input type="date" id="data-fim" name="data-fim">
        </div>
        </div>

        <div class="watchlist-section">
            
            <% if (typeof user !== 'undefined' && user) { %>
                <h3>A minha Watchlist</h3>
                <p>Olá, <%= user.Nome_de_Utilizador %>! Aqui está a tua watchlist personalizada.</p>
                <ul id="watchlist-movies">
                    <li><a href="/details/${movie.id}"><img src="/img/Wicked_ForGoodCover.jpg" alt="Movie 1"></a></li>
                    <li><a href="/details/${movie.id}"><img src="/img/Fallout_Cover.jpg" alt="Movie 2"></a></li>
                    <li><a href="/details/${movie.id}"><img src="/img/Wicked_ForGoodCover.jpg" alt="Movie 3"></a></li>
                    <li><a href="/details/${movie.id}"><img src="/img/Fallout_Cover.jpg" alt="Movie 4"></a></li>
                    <li><a href="/details/${movie.id}"><img src="/img/Wicked_ForGoodCover.jpg" alt="Movie 5"></a></li>
                    <li><a href="/details/${movie.id}"><img src="/img/Fallout_Cover.jpg" alt="Movie 6"></a></li>

                    <li><a href="/details/${movie.id}"><img src="/img/Wicked_ForGoodCover.jpg" alt="Movie 7"></a></li>
                    <li><a href="/details/${movie.id}"><img src="/img/Fallout_Cover.jpg" alt="Movie 8"></a></li>
                    <li><a href="/details/${movie.id}"><img src="/img/Wicked_ForGoodCover.jpg" alt="Movie 9"></a></li>
                    <li><a href="/details/${movie.id}"><img src="/img/Fallout_Cover.jpg" alt="Movie 10"></a></li>
                    <li><a href="/details/${movie.id}"><img src="/img/Wicked_ForGoodCover.jpg" alt="Movie 11"></a></li>
                    <li><a href="/details/${movie.id}"><img src="/img/Fallout_Cover.jpg" alt="Movie 12"></a></li> 

                    <li><a href="/details/${movie.id}"><img src="/img/Wicked_ForGoodCover.jpg" alt="Movie 13"></a></li>
                    <li><a href="/details/${movie.id}"><img src="/img/Fallout_Cover.jpg" alt="Movie 14"></a></li>
                    <li><a href="/details/${movie.id}"><img src="/img/Wicked_ForGoodCover.jpg" alt="Movie 15"></a></li>
                    <li><a href="/details/${movie.id}"><img src="/img/Fallout_Cover.jpg" alt="Movie 16"></a></li>
                    <li><a href="/details/${movie.id}"><img src="/img/Wicked_ForGoodCover.jpg" alt="Movie 17"></a></li>
                    <li><a href="/details/${movie.id}"><img src="/img/Fallout_Cover.jpg" alt="Movie 18"></a></li>

