<footer class="footer" id="footer">
  <div class="container footer-content">
    <div class="footer-left">
      <a href="#" class="logo footer-logo">
        <div class="logo-icon">
          <img src="/img/Logo.png" alt="FlickCine Logo" class="img-light" />
          <img src="/img/Logo dark.png" alt="FlickCine Logo" class="img-dark" />
        </div>
      </a>
      <div class="social-icons">
        <a href="#">
          <img src="/img/X Logo.png" alt="X" class="img-light" />
          <img src="/img/X Logo white.png" alt="X" class="img-dark" />
        </a>
        <a href="#">
          <img src="/img/Logo Instagram.png" alt="Instagram" class="img-light" />
          <img src="/img/Logo Instagram white.png" alt="Instagram" class="img-dark" />
        </a>
        <a href="#">
          <img src="/img/Logo YouTube.png" alt="YouTube" class="img-light" />
          <img src="/img/Logo YouTube white.png" alt="YouTube" class="img-dark" />
        </a>
        <a href="#">
          <img src="/img/LinkedIn.png" alt="LinkedIn" class="img-light" />
          <img src="/img/LinkedIn white.png" alt="LinkedIn" class="img-dark" />
        </a>
      </div>
    </div>

    <div class="footer-links">
      <a href="/#features">Sobre nós</a>
      <a href="/#footer">Contactos</a>
      <a href="#">Política de privacidade</a>
      <a href="#">Termos e condições</a>
    </div>
  </div>

  <div class="footer-bottom">
    <p>Copyright 2025 © FlickCine. Todos os direitos reservados às respetivas entidades.</p>
  </div>

  <a href="/debug/toggle" id="debug-btn" style="
      position: fixed;
      bottom: 20px;
      right: 20px;
      background-color: #e50914;
      color: white;
      padding: 12px 25px;
      border-radius: 50px;
      font-weight: bold;
      text-decoration: none;
      box-shadow: 0 4px 15px rgba(0,0,0,0.4);
      z-index: 9999;
      font-family: sans-serif;
      border: 2px solid white;
      transition: transform 0.2s, background-color 0.2s;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.9rem;
  ">
      <% if (typeof user !== 'undefined' && user) { %>
          <span>🛑 Logout (Simular)</span>
      <% } else { %>
          <span>🟢 Login (Simular)</span>
      <% } %>
  </a>

  <script>
      const debugBtn = document.getElementById('debug-btn');
      if(debugBtn) {
          debugBtn.onmouseover = () => debugBtn.style.transform = 'scale(1.05) translateY(-2px)';
          debugBtn.onmouseout = () => debugBtn.style.transform = 'scale(1) translateY(0)';
      }
  </script>

</footer>

<script src="/js/darkmode.js"></script>