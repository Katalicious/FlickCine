<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <%- include('partials/head', { extraCss: 'register.css' }) %> 
    </head>
<body>
    <%- include('partials/header') %>

    <h1 class="criar-conta">Login</h1>

    <div class="box">
        <form action="/login" method="POST">
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" placeholder="O teu email" required />

            <label for="password">Palavra-passe:</label>
            <input type="password" id="password" name="password" required />

            <button type="submit" class="botaoregisto" style="margin-top: 20px;">Entrar</button>
            <p class="parag-final">Ainda não tens conta? <a href="/register">Regista-te</a></p>
        </form>
    </div>

    <%- include('partials/footer') %>
    <script src="/js/login.js"></script>
</body>
</html>