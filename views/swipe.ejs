<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <%- include('partials/head', { extraCss: 'swipe.css' }) %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
    <%- include('partials/header') %>

    <div class="swipe-stage">
        <aside class="sidebar-streaming">
            <div class="sidebar-header">Onde Ver</div>
            
            <div class="sidebar-section">
                <h4>Subscrição</h4>
                <div class="streaming-icons" id="stream-subs"></div>
            </div>
            
            <div class="sidebar-section">
                <h4>Alugar</h4>
                <div class="streaming-icons" id="stream-rent"></div>
            </div>
            
            <div class="sidebar-section">
                <h4>Comprar</h4>
                <div class="streaming-icons" id="stream-buy"></div>
            </div>
        </aside>

        <div class="central-wrapper">
            <div id="toast-container"></div>

            <div id="empty-state" style="display:none; text-align:center; padding-top: 150px;">
                <h2 style="color: #e50914; font-size: 2rem; margin-bottom: 10px;">Sem filmes</h2>
            </div>

            <div id="loading-spinner" class="loading-overlay" style="display: none;">
                <div class="spinner"></div>
            </div>

            <div class="card-stack-container" id="card-stack">
                </div>
        </div>

        <aside class="sidebar-stats">
            <div class="progress-panel">
                <div class="progress-info">
                    <span id="swipes-count">30</span><span style="font-size: 0.8em; opacity: 0.8;">/30</span>
                </div>
                <div class="progress-bar-bg">
                    <div class="progress-bar-fill" id="progress-fill" style="height: 100%;"></div>
                </div>
                <div class="timer-info">
                    <span>Renova em:</span><br>
                    <span id="reset-timer" style="font-weight: bold; color: white;">--:--:--</span>
                </div>
            </div>
        </aside>
    </div>

        <audio id="sound-accept" src="/audio/acceptedflick.mp3" preload="auto"></audio>
        <audio id="sound-reject" src="/audio/rejectedflick.mp3" preload="auto"></audio>

    <%- include('partials/footer') %>
    <script src="/js/swipe.js"></script>
</body>
</html>