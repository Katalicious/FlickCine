<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <%- include('partials/head', { extraCss: 'details.css' }) %>
    <script>
        const MOVIE_ID = "<%= movieId %>";
    </script>
</head>
<body>
    <%- include('partials/header') %>

    <div class="container movie-details-container">
        
        <div class="details-left">
            <div class="poster-wrapper">
                <img id="movie-poster" src="https://via.placeholder.com/500x750?text=A+Carregar..." alt="Poster" class="movie-poster">
            </div>
        </div>

        <div class="details-right">
            
            <div class="movie-header-row">
                <div class="movie-title-info">
                    <h1 id="movie-title">A carregar...</h1>
                    
                    <div class="meta-row">
                        <span id="movie-year" class="meta-tag">----</span>
                        <span id="movie-age" class="meta-tag">--</span>
                        <span id="movie-duration" class="meta-tag">--h --m</span>
                    </div>

                    <div class="rating-star">⭐ <strong id="movie-rating">--/10</strong></div>
                </div>

                <div class="streaming-box" id="streaming-container">
                    <div class="jw-section logo-section">
                        <span class="jw-brand">Onde Ver</span>
                    </div>
                    <div class="jw-section"><span class="no-stream">...</span></div>
                    <div class="jw-section"><span class="no-stream">...</span></div>
                    <div class="jw-section"><span class="no-stream">...</span></div>
                </div>
            </div>

            <hr class="divider">

            <div class="details-tabs">
                <button class="tab-btn active" onclick="openTab(event, 'tab-overview')">Overview</button>
                <button class="tab-btn" onclick="openTab(event, 'tab-details')">More details</button>
                <button class="tab-btn" onclick="openTab(event, 'tab-similar')">More like this</button>
            </div>

            <div id="tab-overview" class="tab-content active">
                <p class="synopsis" id="movie-description">A carregar sinopse...</p>
                <div class="meta-list">
                    <div class="meta-item">
                        <span class="label">Genre</span>
                        <span class="value" id="movie-genres">--</span>
                    </div>
                    <div class="meta-item">
                        <span class="label">Starring</span>
                        <span class="value" id="movie-cast">--</span>
                    </div>
                    <div class="meta-item">
                        <span class="label">Created by</span>
                        <span class="value" id="movie-director">--</span>
                    </div>
                </div>
            </div>

            <div id="tab-details" class="tab-content" style="display: none;">
                <div class="meta-list">
                    <div class="meta-item">
                        <span class="label">Budget</span>
                        <span class="value" id="movie-budget">--</span>
                    </div>
                    <div class="meta-item">
                        <span class="label">Revenue</span>
                        <span class="value" id="movie-revenue">--</span>
                    </div>
                    <div class="meta-item">
                        <span class="label">Original Language</span>
                        <span class="value" id="movie-language">--</span>
                    </div>
                    <div class="meta-item">
                        <span class="label">Production</span>
                        <span class="value" id="movie-production">--</span>
                    </div>
                </div>
            </div>

            <div id="tab-similar" class="tab-content" style="display: none;">
                <div class="similar-movies-grid" id="similar-grid">
                    </div>
            </div>

        </div> </div> <%- include('partials/footer') %>
    <script src="/js/details.js"></script>
</body>
</html>