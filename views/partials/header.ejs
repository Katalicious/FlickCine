<header class="header">
  <div class="container header-content">
    <a href="/" class="logo">
      <div class="logo-icon">
        <img src="/img/Logo.png" alt="FlickCine Logo" class="img-light" />
        <img src="/img/Logo dark.png" alt="FlickCine Logo" class="img-dark" />
      </div>
    </a>

    <nav class="navbar">
      <a href="/">Home</a>
      <a href="/#features">Sobre nós</a>
      <a href="/#footer">Contacto</a>
      <a href="/swipe" class="highlight-link">Explora os teus gostos</a>
    </nav>

    <div class="actions">
      <div class="theme-switch-wrapper">
        <label class="theme-switch" for="checkbox">
          <input type="checkbox" id="checkbox" />
          <div class="slider round">
            <span class="icon-sun">
              <img src="/img/light.png" alt="Sun" class="img-light" />
              <img src="/img/light_mode.png" alt="Sun" class="img-dark" />
            </span>
            <span class="icon-moon">
              <img src="/img/dark_mode.png" alt="Moon" class="img-light" />
              <img src="/img/dark.png" alt="Moon" class="img-dark" />
            </span>
          </div>
        </label>
      </div>

      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/profile" style="display: block; margin-left: 15px;">
            <img 
              src="<%= (user && user.id) ? ('/avatars/' + user.id) : '/img/avatar_placeholder.png' %>" 
              alt="O teu perfil" 
              class="img-light" 
              style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 2px solid #1D1D1D;"
            >
            <img 
              src="<%= (user && user.id) ? ('/avatars/' + user.id) : '/img/avatar_placeholder.png' %>"
              alt="O teu perfil" 
              class="img-dark" 
              style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 2px solid #FFFFFF;"
            >
        </a>

        <div class="dropdown">
          <button class="dropbtn"><%= user.Nome_de_Utilizador || user.name || user.Name || 'Perfil' %> ▾</button>
          <div class="dropdown-content">
            <a href="/profile">Perfil</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      <% } else { %>
        <a href="/login" class="btn btn-login">Login</a>
        <a href="/register" class="btn btn-signup">Criar conta</a>
      <% } %>

    </div>
  </div>
</header>